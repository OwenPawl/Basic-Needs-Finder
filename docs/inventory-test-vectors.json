{
  "version": 1,
  "status": "Proposal for review under task inventory-test-cases. Implementation-neutral; inventory-core turns these into executable PostgreSQL tests.",
  "source": "docs/DOMAIN.md inventory invariants and state boundaries; docs/MVP.md demonstration script; docs/PROJECT_PLAN.txt sections 4-5.",
  "conventions": {
    "state": "Lot state is {status, on_hand, reserved}. available = on_hand - reserved is derived, never stored independently.",
    "time": "Server UTC only. A reservation is expired when server_now >= expires_at. Client-supplied timestamps are ignored.",
    "hold_ttl": "HOLD_TTL is a team decision (see MVP.md). Tests must read it from configuration and control the clock; never sleep for real TTLs.",
    "idempotency": "Every mutation carries an idempotency_key scoped to the acting user. Same key + same payload replays the original result without a new event. Same key + different payload is IDEMPOTENCY_CONFLICT.",
    "events": "events_added counts inventory events written by the operation. Rejected operations write none.",
    "errors": "Rejected operations leave lot and reservation state exactly as before.",
    "pickup": "MVP pickup collects the whole reservation quantity; partial pickup is out of scope."
  },
  "error_codes": {
    "UNAUTHENTICATED": "No valid session.",
    "FORBIDDEN": "Authenticated but lacks the role, verification, or location staff assignment.",
    "NOT_FOUND": "Object does not exist or belongs to another campus. Used instead of FORBIDDEN where existence would leak.",
    "VALIDATION_ERROR": "Malformed or out-of-range input (quantity, missing reason, missing food metadata).",
    "INSUFFICIENT_STOCK": "Requested quantity exceeds available units.",
    "NOT_RESERVABLE": "Lot is pledged (not yet received) or removed.",
    "INVALID_STATE": "Conditional transition failed: already received, reservation not active, lot removed.",
    "RESERVATION_EXPIRED": "Reservation passed expires_at; the operation releases its hold once and refuses the request.",
    "IDEMPOTENCY_CONFLICT": "Idempotency key reused with a different payload.",
    "WOULD_VIOLATE_RESERVATIONS": "Correction would make on_hand smaller than reserved."
  },
  "fixtures": {
    "campuses": [
      {"id": "campus-north", "name": "Fictional North Campus", "email_domains": ["north.example.edu"]},
      {"id": "campus-south", "name": "Fictional South Campus", "email_domains": ["south.example.edu"]}
    ],
    "locations": [
      {"id": "loc-commons", "campus": "campus-north", "name": "Commons Pantry Shelf (fictional)"},
      {"id": "loc-library", "campus": "campus-north", "name": "Library Lobby Locker (fictional)"},
      {"id": "loc-south-hall", "campus": "campus-south", "name": "South Hall Desk (fictional)"}
    ],
    "users": [
      {"id": "student-donor", "campus": "campus-north", "role": "student", "verified": true},
      {"id": "student-a", "campus": "campus-north", "role": "student", "verified": true},
      {"id": "student-b", "campus": "campus-north", "role": "student", "verified": true},
      {"id": "student-unverified", "campus": "campus-north", "role": "student", "verified": false},
      {"id": "student-south", "campus": "campus-south", "role": "student", "verified": true},
      {"id": "staff-commons", "campus": "campus-north", "role": "staff", "verified": true, "staff_locations": ["loc-commons"]},
      {"id": "staff-library", "campus": "campus-north", "role": "staff", "verified": true, "staff_locations": ["loc-library"]},
      {"id": "staff-south", "campus": "campus-south", "role": "staff", "verified": true, "staff_locations": ["loc-south-hall"]}
    ],
    "lots": [
      {"id": "lot-pledged", "location": "loc-commons", "donor": "student-donor", "category": "Household Essentials", "title": "Toothpaste, sealed (fictional)", "pledged_quantity": 2, "status": "pledged", "on_hand": 0, "reserved": 0},
      {"id": "lot-two", "location": "loc-commons", "donor": "student-donor", "category": "Household Essentials", "title": "Bar soap, sealed (fictional)", "pledged_quantity": 2, "status": "received", "on_hand": 2, "reserved": 0},
      {"id": "lot-last", "location": "loc-commons", "donor": "student-donor", "category": "Clothing", "title": "Winter gloves (fictional)", "pledged_quantity": 1, "status": "received", "on_hand": 1, "reserved": 0},
      {"id": "lot-removed", "location": "loc-commons", "donor": "student-donor", "category": "Food", "title": "Granola bars, damaged packaging (fictional)", "pledged_quantity": 3, "status": "removed", "on_hand": 0, "reserved": 0},
      {"id": "lot-food-pledged", "location": "loc-commons", "donor": "student-donor", "category": "Food", "title": "Canned black beans (fictional)", "pledged_quantity": 2, "status": "pledged", "on_hand": 0, "reserved": 0,
       "food": {"photo": "fixture://beans.jpg", "date_label": "2027-06-01", "package_status": "sealed", "shelf_stable": true, "storage": "room temperature", "allergens": "unknown"}},
      {"id": "lot-south", "location": "loc-south-hall", "donor": "student-south", "category": "School Supplies", "title": "Spiral notebook (fictional)", "pledged_quantity": 1, "status": "received", "on_hand": 1, "reserved": 0}
    ]
  },
  "cases": [
    {"id": "P1", "group": "pledge", "title": "Verified student pledges two units; nothing becomes available",
     "actor": "student-donor", "op": "pledge", "input": {"location": "loc-commons", "quantity": 2},
     "before": null, "expect": {"result": "ok", "after": {"status": "pledged", "on_hand": 0, "reserved": 0}, "events_added": 0}},
    {"id": "P2", "group": "pledge", "title": "Reserving a pledged lot is refused",
     "actor": "student-a", "op": "reserve", "input": {"lot": "lot-pledged", "quantity": 1},
     "before": {"status": "pledged", "on_hand": 0, "reserved": 0}, "expect": {"result": "NOT_RESERVABLE", "after": {"status": "pledged", "on_hand": 0, "reserved": 0}, "events_added": 0}},
    {"id": "P3", "group": "pledge", "title": "Unverified student cannot pledge",
     "actor": "student-unverified", "op": "pledge", "input": {"location": "loc-commons", "quantity": 1},
     "before": null, "expect": {"result": "FORBIDDEN", "after": null, "events_added": 0}},
    {"id": "P4", "group": "pledge", "title": "Food pledge without known allergens stores allergens as unknown, never as none",
     "actor": "student-donor", "op": "pledge", "input": {"location": "loc-commons", "quantity": 2, "food": {"photo": "fixture://beans.jpg", "date_label": "2027-06-01", "package_status": "sealed", "shelf_stable": true, "storage": "room temperature"}},
     "before": null, "expect": {"result": "ok", "after": {"status": "pledged", "on_hand": 0, "reserved": 0}, "events_added": 0, "notes": "Stored food.allergens == \"unknown\"."}},
    {"id": "P5", "group": "pledge", "title": "Food pledge missing photo or date label is rejected",
     "actor": "student-donor", "op": "pledge", "input": {"location": "loc-commons", "quantity": 1, "food": {"package_status": "sealed", "shelf_stable": true, "storage": "room temperature"}},
     "before": null, "expect": {"result": "VALIDATION_ERROR", "after": null, "events_added": 0}},
    {"id": "P6", "group": "pledge", "title": "Unsealed or non-shelf-stable food is rejected",
     "actor": "student-donor", "op": "pledge", "input": {"location": "loc-commons", "quantity": 1, "food": {"photo": "fixture://soup.jpg", "date_label": "2026-11-10", "package_status": "opened", "shelf_stable": false, "storage": "refrigerated"}},
     "before": null, "expect": {"result": "VALIDATION_ERROR", "after": null, "events_added": 0}},

    {"id": "R1", "group": "receipt", "title": "Assigned staff confirms receipt of two units",
     "actor": "staff-commons", "op": "receive", "input": {"lot": "lot-pledged", "quantity": 2, "idempotency_key": "rcv-1"},
     "before": {"status": "pledged", "on_hand": 0, "reserved": 0}, "expect": {"result": "ok", "after": {"status": "received", "on_hand": 2, "reserved": 0}, "events_added": 1}},
    {"id": "R2", "group": "receipt", "title": "Retrying the same receipt key changes nothing",
     "actor": "staff-commons", "op": "receive", "input": {"lot": "lot-pledged", "quantity": 2, "idempotency_key": "rcv-1"}, "after_case": "R1",
     "before": {"status": "received", "on_hand": 2, "reserved": 0}, "expect": {"result": "ok (replayed R1 result)", "after": {"status": "received", "on_hand": 2, "reserved": 0}, "events_added": 0}},
    {"id": "R3", "group": "receipt", "title": "A second receipt with a new key is refused",
     "actor": "staff-commons", "op": "receive", "input": {"lot": "lot-pledged", "quantity": 2, "idempotency_key": "rcv-2"}, "after_case": "R1",
     "before": {"status": "received", "on_hand": 2, "reserved": 0}, "expect": {"result": "INVALID_STATE", "after": {"status": "received", "on_hand": 2, "reserved": 0}, "events_added": 0}},
    {"id": "R4", "group": "receipt", "title": "Reusing a receipt key with a different quantity is a conflict",
     "actor": "staff-commons", "op": "receive", "input": {"lot": "lot-pledged", "quantity": 1, "idempotency_key": "rcv-1"}, "after_case": "R1",
     "before": {"status": "received", "on_hand": 2, "reserved": 0}, "expect": {"result": "IDEMPOTENCY_CONFLICT", "after": {"status": "received", "on_hand": 2, "reserved": 0}, "events_added": 0}},
    {"id": "R5", "group": "receipt", "title": "Staff confirms fewer units than pledged; only received units count",
     "actor": "staff-commons", "op": "receive", "input": {"lot": "lot-pledged", "quantity": 1, "idempotency_key": "rcv-3"},
     "before": {"status": "pledged", "on_hand": 0, "reserved": 0}, "expect": {"result": "ok", "after": {"status": "received", "on_hand": 1, "reserved": 0}, "events_added": 1}},
    {"id": "R6", "group": "receipt", "title": "Receipt quantity of zero, negative, fractional, or above the pledge is rejected",
     "actor": "staff-commons", "op": "receive", "input": {"lot": "lot-pledged", "quantity_cases": [0, -1, 1.5, 3], "idempotency_key": "rcv-bad"},
     "before": {"status": "pledged", "on_hand": 0, "reserved": 0}, "expect": {"result": "VALIDATION_ERROR", "after": {"status": "pledged", "on_hand": 0, "reserved": 0}, "events_added": 0}},
    {"id": "R7", "group": "receipt", "title": "Staff assigned to a different location cannot receive",
     "actor": "staff-library", "op": "receive", "input": {"lot": "lot-pledged", "quantity": 2, "idempotency_key": "rcv-4"},
     "before": {"status": "pledged", "on_hand": 0, "reserved": 0}, "expect": {"result": "FORBIDDEN", "after": {"status": "pledged", "on_hand": 0, "reserved": 0}, "events_added": 0}},
    {"id": "R8", "group": "receipt", "title": "A student cannot confirm a receipt, including their own donation",
     "actor": "student-donor", "op": "receive", "input": {"lot": "lot-pledged", "quantity": 2, "idempotency_key": "rcv-5"},
     "before": {"status": "pledged", "on_hand": 0, "reserved": 0}, "expect": {"result": "FORBIDDEN", "after": {"status": "pledged", "on_hand": 0, "reserved": 0}, "events_added": 0}},

    {"id": "V1", "group": "reserve", "title": "Student reserves one of two units",
     "actor": "student-a", "op": "reserve", "input": {"lot": "lot-two", "quantity": 1, "idempotency_key": "res-a1"},
     "before": {"status": "received", "on_hand": 2, "reserved": 0}, "expect": {"result": "ok", "after": {"status": "received", "on_hand": 2, "reserved": 1}, "reservation": "active, expires_at = server_now + HOLD_TTL", "events_added": 1}},
    {"id": "V2", "group": "reserve", "title": "Retrying the same reservation key returns the same reservation",
     "actor": "student-a", "op": "reserve", "input": {"lot": "lot-two", "quantity": 1, "idempotency_key": "res-a1"}, "after_case": "V1",
     "before": {"status": "received", "on_hand": 2, "reserved": 1}, "expect": {"result": "ok (same reservation id as V1)", "after": {"status": "received", "on_hand": 2, "reserved": 1}, "events_added": 0}},
    {"id": "V3", "group": "reserve", "title": "Reusing a reservation key with a different quantity is a conflict",
     "actor": "student-a", "op": "reserve", "input": {"lot": "lot-two", "quantity": 2, "idempotency_key": "res-a1"}, "after_case": "V1",
     "before": {"status": "received", "on_hand": 2, "reserved": 1}, "expect": {"result": "IDEMPOTENCY_CONFLICT", "after": {"status": "received", "on_hand": 2, "reserved": 1}, "events_added": 0}},
    {"id": "V4", "group": "reserve", "title": "A partially reserved lot still accepts a reservation for its remaining unit",
     "actor": "student-b", "op": "reserve", "input": {"lot": "lot-two", "quantity": 1, "idempotency_key": "res-b1"}, "after_case": "V1",
     "before": {"status": "received", "on_hand": 2, "reserved": 1}, "expect": {"result": "ok", "after": {"status": "received", "on_hand": 2, "reserved": 2}, "reservation": "active", "events_added": 1}},
    {"id": "V5", "group": "reserve", "title": "Reserving more than available is refused",
     "actor": "student-b", "op": "reserve", "input": {"lot": "lot-two", "quantity": 2, "idempotency_key": "res-b2"}, "after_case": "V1",
     "before": {"status": "received", "on_hand": 2, "reserved": 1}, "expect": {"result": "INSUFFICIENT_STOCK", "after": {"status": "received", "on_hand": 2, "reserved": 1}, "events_added": 0}},
    {"id": "V6", "group": "reserve", "title": "Reservation quantity of zero, negative, or fractional is rejected",
     "actor": "student-a", "op": "reserve", "input": {"lot": "lot-two", "quantity_cases": [0, -1, 0.5], "idempotency_key": "res-bad"},
     "before": {"status": "received", "on_hand": 2, "reserved": 0}, "expect": {"result": "VALIDATION_ERROR", "after": {"status": "received", "on_hand": 2, "reserved": 0}, "events_added": 0}},
    {"id": "V7", "group": "reserve", "title": "Removed stock is not reservable",
     "actor": "student-a", "op": "reserve", "input": {"lot": "lot-removed", "quantity": 1, "idempotency_key": "res-a2"},
     "before": {"status": "removed", "on_hand": 0, "reserved": 0}, "expect": {"result": "NOT_RESERVABLE", "after": {"status": "removed", "on_hand": 0, "reserved": 0}, "events_added": 0}},
    {"id": "V8", "group": "reserve", "title": "Unverified student cannot reserve",
     "actor": "student-unverified", "op": "reserve", "input": {"lot": "lot-two", "quantity": 1, "idempotency_key": "res-u1"},
     "before": {"status": "received", "on_hand": 2, "reserved": 0}, "expect": {"result": "FORBIDDEN", "after": {"status": "received", "on_hand": 2, "reserved": 0}, "events_added": 0}},
    {"id": "V9", "group": "reserve", "title": "Student from another campus cannot see or reserve the lot",
     "actor": "student-south", "op": "reserve", "input": {"lot": "lot-two", "quantity": 1, "idempotency_key": "res-s1"},
     "before": {"status": "received", "on_hand": 2, "reserved": 0}, "expect": {"result": "NOT_FOUND", "after": {"status": "received", "on_hand": 2, "reserved": 0}, "events_added": 0}},

    {"id": "C1", "group": "cancel", "title": "Student cancels their active reservation; the hold is released once",
     "actor": "student-a", "op": "cancel", "input": {"reservation": "V1", "idempotency_key": "can-a1"}, "after_case": "V1",
     "before": {"status": "received", "on_hand": 2, "reserved": 1}, "expect": {"result": "ok", "after": {"status": "received", "on_hand": 2, "reserved": 0}, "reservation": "cancelled", "events_added": 1}},
    {"id": "C2", "group": "cancel", "title": "Retrying the same cancel key changes nothing",
     "actor": "student-a", "op": "cancel", "input": {"reservation": "V1", "idempotency_key": "can-a1"}, "after_case": "C1",
     "before": {"status": "received", "on_hand": 2, "reserved": 0}, "expect": {"result": "ok (replayed C1 result)", "after": {"status": "received", "on_hand": 2, "reserved": 0}, "reservation": "cancelled", "events_added": 0}},
    {"id": "C3", "group": "cancel", "title": "Cancelling again with a new key is refused; reserved never goes below zero",
     "actor": "student-a", "op": "cancel", "input": {"reservation": "V1", "idempotency_key": "can-a2"}, "after_case": "C1",
     "before": {"status": "received", "on_hand": 2, "reserved": 0}, "expect": {"result": "INVALID_STATE", "after": {"status": "received", "on_hand": 2, "reserved": 0}, "events_added": 0}},
    {"id": "C4", "group": "cancel", "title": "Another student cannot cancel someone else's reservation",
     "actor": "student-b", "op": "cancel", "input": {"reservation": "V1", "idempotency_key": "can-b1"}, "after_case": "V1",
     "before": {"status": "received", "on_hand": 2, "reserved": 1}, "expect": {"result": "NOT_FOUND", "after": {"status": "received", "on_hand": 2, "reserved": 1}, "reservation": "active", "events_added": 0}},
    {"id": "C5", "group": "cancel", "title": "Staff at the lot's location may release a reservation",
     "actor": "staff-commons", "op": "cancel", "input": {"reservation": "V1", "idempotency_key": "can-st1"}, "after_case": "V1",
     "before": {"status": "received", "on_hand": 2, "reserved": 1}, "expect": {"result": "ok", "after": {"status": "received", "on_hand": 2, "reserved": 0}, "reservation": "cancelled", "events_added": 1}},
    {"id": "C6", "group": "cancel", "title": "Staff at a different location cannot release it",
     "actor": "staff-library", "op": "cancel", "input": {"reservation": "V1", "idempotency_key": "can-st2"}, "after_case": "V1",
     "before": {"status": "received", "on_hand": 2, "reserved": 1}, "expect": {"result": "FORBIDDEN", "after": {"status": "received", "on_hand": 2, "reserved": 1}, "reservation": "active", "events_added": 0}},
    {"id": "C7", "group": "cancel", "title": "A completed (picked-up) reservation cannot be cancelled",
     "actor": "student-a", "op": "cancel", "input": {"reservation": "V1", "idempotency_key": "can-a3"}, "after_case": "K1",
     "before": {"status": "received", "on_hand": 1, "reserved": 0}, "expect": {"result": "INVALID_STATE", "after": {"status": "received", "on_hand": 1, "reserved": 0}, "reservation": "completed", "events_added": 0}},

    {"id": "E1", "group": "expiry", "title": "One second before expires_at, a sweep does nothing",
     "actor": "system", "op": "expire_sweep", "input": {"clock": "expires_at - 1s"}, "after_case": "V1",
     "before": {"status": "received", "on_hand": 2, "reserved": 1}, "expect": {"result": "ok (0 expired)", "after": {"status": "received", "on_hand": 2, "reserved": 1}, "reservation": "active", "events_added": 0}},
    {"id": "E2", "group": "expiry", "title": "At expires_at, a sweep expires the hold and releases it once",
     "actor": "system", "op": "expire_sweep", "input": {"clock": "expires_at"}, "after_case": "V1",
     "before": {"status": "received", "on_hand": 2, "reserved": 1}, "expect": {"result": "ok (1 expired)", "after": {"status": "received", "on_hand": 2, "reserved": 0}, "reservation": "expired", "events_added": 1}},
    {"id": "E3", "group": "expiry", "title": "Running the sweep twice releases nothing more",
     "actor": "system", "op": "expire_sweep", "input": {"clock": "expires_at + 1s"}, "after_case": "E2",
     "before": {"status": "received", "on_hand": 2, "reserved": 0}, "expect": {"result": "ok (0 expired)", "after": {"status": "received", "on_hand": 2, "reserved": 0}, "reservation": "expired", "events_added": 0}},
    {"id": "E4", "group": "expiry", "title": "An unswept expired hold does not block the last unit",
     "actor": "student-b", "op": "reserve", "input": {"lot": "lot-last", "quantity": 1, "idempotency_key": "res-b3", "clock": "student-a hold expires_at + 1s, no sweep run"},
     "setup": "student-a holds the only unit of lot-last; the hold has passed expires_at but no sweep ran.",
     "before": {"status": "received", "on_hand": 1, "reserved": 1}, "expect": {"result": "ok", "after": {"status": "received", "on_hand": 1, "reserved": 1}, "reservation": "student-a hold becomes expired in the same transaction; student-b hold active", "events_added": 2}},
    {"id": "E5", "group": "expiry", "title": "Pickup of an expired, unswept reservation is refused and releases the hold once",
     "actor": "staff-commons", "op": "pickup", "input": {"reservation": "V1", "idempotency_key": "pk-exp", "clock": "expires_at + 1s, no sweep run"}, "after_case": "V1",
     "before": {"status": "received", "on_hand": 2, "reserved": 1}, "expect": {"result": "RESERVATION_EXPIRED", "after": {"status": "received", "on_hand": 2, "reserved": 0}, "reservation": "expired", "events_added": 1}},
    {"id": "E6", "group": "expiry", "title": "Cancel of an expired, unswept reservation releases the hold exactly once",
     "actor": "student-a", "op": "cancel", "input": {"reservation": "V1", "idempotency_key": "can-exp", "clock": "expires_at + 1s, no sweep run"}, "after_case": "V1",
     "before": {"status": "received", "on_hand": 2, "reserved": 1}, "expect": {"result": "RESERVATION_EXPIRED", "after": {"status": "received", "on_hand": 2, "reserved": 0}, "reservation": "expired", "events_added": 1}},

    {"id": "K1", "group": "pickup", "title": "Assigned staff confirms pickup; on_hand and reserved both drop once",
     "actor": "staff-commons", "op": "pickup", "input": {"reservation": "V1", "idempotency_key": "pk-1"}, "after_case": "V1",
     "before": {"status": "received", "on_hand": 2, "reserved": 1}, "expect": {"result": "ok", "after": {"status": "received", "on_hand": 1, "reserved": 0}, "reservation": "completed", "events_added": 1}},
    {"id": "K2", "group": "pickup", "title": "Retrying the same pickup key changes nothing",
     "actor": "staff-commons", "op": "pickup", "input": {"reservation": "V1", "idempotency_key": "pk-1"}, "after_case": "K1",
     "before": {"status": "received", "on_hand": 1, "reserved": 0}, "expect": {"result": "ok (replayed K1 result)", "after": {"status": "received", "on_hand": 1, "reserved": 0}, "reservation": "completed", "events_added": 0}},
    {"id": "K3", "group": "pickup", "title": "A second pickup with a new key is refused",
     "actor": "staff-commons", "op": "pickup", "input": {"reservation": "V1", "idempotency_key": "pk-2"}, "after_case": "K1",
     "before": {"status": "received", "on_hand": 1, "reserved": 0}, "expect": {"result": "INVALID_STATE", "after": {"status": "received", "on_hand": 1, "reserved": 0}, "reservation": "completed", "events_added": 0}},
    {"id": "K4", "group": "pickup", "title": "Pickup of a cancelled reservation is refused",
     "actor": "staff-commons", "op": "pickup", "input": {"reservation": "V1", "idempotency_key": "pk-3"}, "after_case": "C1",
     "before": {"status": "received", "on_hand": 2, "reserved": 0}, "expect": {"result": "INVALID_STATE", "after": {"status": "received", "on_hand": 2, "reserved": 0}, "reservation": "cancelled", "events_added": 0}},
    {"id": "K5", "group": "pickup", "title": "Staff at a different location cannot confirm pickup",
     "actor": "staff-library", "op": "pickup", "input": {"reservation": "V1", "idempotency_key": "pk-4"}, "after_case": "V1",
     "before": {"status": "received", "on_hand": 2, "reserved": 1}, "expect": {"result": "FORBIDDEN", "after": {"status": "received", "on_hand": 2, "reserved": 1}, "reservation": "active", "events_added": 0}},
    {"id": "K6", "group": "pickup", "title": "The reserving student cannot confirm their own pickup",
     "actor": "student-a", "op": "pickup", "input": {"reservation": "V1", "idempotency_key": "pk-5"}, "after_case": "V1",
     "before": {"status": "received", "on_hand": 2, "reserved": 1}, "expect": {"result": "FORBIDDEN", "after": {"status": "received", "on_hand": 2, "reserved": 1}, "reservation": "active", "events_added": 0}},
    {"id": "K7", "group": "pickup", "title": "Picking up the last unit leaves an empty but still received lot",
     "actor": "staff-commons", "op": "pickup", "input": {"reservation": "student-a hold on lot-last", "idempotency_key": "pk-6"},
     "setup": "student-a holds the only unit of lot-last (active, unexpired).",
     "before": {"status": "received", "on_hand": 1, "reserved": 1}, "expect": {"result": "ok", "after": {"status": "received", "on_hand": 0, "reserved": 0}, "reservation": "completed", "events_added": 1}},

    {"id": "X1", "group": "correction", "title": "Staff corrects on_hand upward with a reason; audit records before/after",
     "actor": "staff-commons", "op": "correct", "input": {"lot": "lot-two", "on_hand": 3, "reason": "Found an extra bar during recount", "idempotency_key": "cor-1"},
     "before": {"status": "received", "on_hand": 2, "reserved": 0}, "expect": {"result": "ok", "after": {"status": "received", "on_hand": 3, "reserved": 0}, "events_added": 1, "notes": "Event stores actor, reason, on_hand_before=2, on_hand_after=3."}},
    {"id": "X2", "group": "correction", "title": "Correction without a reason is rejected",
     "actor": "staff-commons", "op": "correct", "input": {"lot": "lot-two", "on_hand": 1, "reason": "", "idempotency_key": "cor-2"},
     "before": {"status": "received", "on_hand": 2, "reserved": 0}, "expect": {"result": "VALIDATION_ERROR", "after": {"status": "received", "on_hand": 2, "reserved": 0}, "events_added": 0}},
    {"id": "X3", "group": "correction", "title": "Correction below the reserved count is refused",
     "actor": "staff-commons", "op": "correct", "input": {"lot": "lot-two", "on_hand": 1, "reason": "Recount found one bar", "idempotency_key": "cor-3"}, "after_case": "V4",
     "before": {"status": "received", "on_hand": 2, "reserved": 2}, "expect": {"result": "WOULD_VIOLATE_RESERVATIONS", "after": {"status": "received", "on_hand": 2, "reserved": 2}, "events_added": 0}},
    {"id": "X4", "group": "correction", "title": "Correction down to exactly the reserved count is allowed",
     "actor": "staff-commons", "op": "correct", "input": {"lot": "lot-two", "on_hand": 1, "reason": "Recount found one bar", "idempotency_key": "cor-4"}, "after_case": "V1",
     "before": {"status": "received", "on_hand": 2, "reserved": 1}, "expect": {"result": "ok", "after": {"status": "received", "on_hand": 1, "reserved": 1}, "events_added": 1}},
    {"id": "X5", "group": "correction", "title": "Negative or fractional corrected on_hand is rejected",
     "actor": "staff-commons", "op": "correct", "input": {"lot": "lot-two", "on_hand_cases": [-1, 1.5], "reason": "Typo", "idempotency_key": "cor-5"},
     "before": {"status": "received", "on_hand": 2, "reserved": 0}, "expect": {"result": "VALIDATION_ERROR", "after": {"status": "received", "on_hand": 2, "reserved": 0}, "events_added": 0}},
    {"id": "X6", "group": "correction", "title": "Students and other-location staff cannot correct stock",
     "actor_cases": ["student-a", "staff-library", "staff-south"], "op": "correct", "input": {"lot": "lot-two", "on_hand": 5, "reason": "Attempt", "idempotency_key": "cor-6"},
     "before": {"status": "received", "on_hand": 2, "reserved": 0}, "expect": {"result": "FORBIDDEN (student-a, staff-library); NOT_FOUND (staff-south)", "after": {"status": "received", "on_hand": 2, "reserved": 0}, "events_added": 0}},

    {"id": "U1", "group": "removal", "title": "Staff removes unsafe stock with no holds; it leaves inventory",
     "actor": "staff-commons", "op": "remove", "input": {"lot": "lot-two", "reason": "Packaging damaged", "idempotency_key": "rm-1"},
     "before": {"status": "received", "on_hand": 2, "reserved": 0}, "expect": {"result": "ok", "after": {"status": "removed", "on_hand": 0, "reserved": 0}, "events_added": 1, "notes": "Event records quantity_removed=2 and the reason."}},
    {"id": "U2", "group": "removal", "title": "Removing stock with active holds cancels those holds in the same transaction",
     "actor": "staff-commons", "op": "remove", "input": {"lot": "lot-two", "reason": "Recall notice", "idempotency_key": "rm-2"}, "after_case": "V1",
     "before": {"status": "received", "on_hand": 2, "reserved": 1}, "expect": {"result": "ok", "after": {"status": "removed", "on_hand": 0, "reserved": 0}, "reservation": "cancelled (reason stock_removed)", "events_added": 2}},
    {"id": "U3", "group": "removal", "title": "Resolving a hold on removed stock never makes it available again",
     "actor": "student-a", "op": "cancel", "input": {"reservation": "V1", "idempotency_key": "can-rm"}, "after_case": "U2",
     "before": {"status": "removed", "on_hand": 0, "reserved": 0}, "expect": {"result": "INVALID_STATE", "after": {"status": "removed", "on_hand": 0, "reserved": 0}, "reservation": "cancelled", "events_added": 0}},
    {"id": "U4", "group": "removal", "title": "Removed stock cannot be corrected back into inventory",
     "actor": "staff-commons", "op": "correct", "input": {"lot": "lot-removed", "on_hand": 3, "reason": "Undo", "idempotency_key": "cor-rm"},
     "before": {"status": "removed", "on_hand": 0, "reserved": 0}, "expect": {"result": "INVALID_STATE", "after": {"status": "removed", "on_hand": 0, "reserved": 0}, "events_added": 0}},
    {"id": "U5", "group": "removal", "title": "Retrying the same removal key changes nothing",
     "actor": "staff-commons", "op": "remove", "input": {"lot": "lot-two", "reason": "Packaging damaged", "idempotency_key": "rm-1"}, "after_case": "U1",
     "before": {"status": "removed", "on_hand": 0, "reserved": 0}, "expect": {"result": "ok (replayed U1 result)", "after": {"status": "removed", "on_hand": 0, "reserved": 0}, "events_added": 0}},

    {"id": "A1", "group": "auth", "title": "Any mutation without a session is rejected",
     "actor": "anonymous", "op_cases": ["pledge", "receive", "reserve", "cancel", "pickup", "correct", "remove"], "input": {"lot": "lot-two"},
     "before": {"status": "received", "on_hand": 2, "reserved": 0}, "expect": {"result": "UNAUTHENTICATED", "after": {"status": "received", "on_hand": 2, "reserved": 0}, "events_added": 0}},
    {"id": "A2", "group": "auth", "title": "A role or staff_locations claim in the request body is ignored",
     "actor": "student-a", "op": "receive", "input": {"lot": "lot-pledged", "quantity": 2, "idempotency_key": "rcv-forged", "role": "staff", "staff_locations": ["loc-commons"]},
     "before": {"status": "pledged", "on_hand": 0, "reserved": 0}, "expect": {"result": "FORBIDDEN", "after": {"status": "pledged", "on_hand": 0, "reserved": 0}, "events_added": 0}},
    {"id": "A3", "group": "auth", "title": "Staff from another campus cannot reach this campus's lots",
     "actor": "staff-south", "op": "pickup", "input": {"reservation": "V1", "idempotency_key": "pk-south"}, "after_case": "V1",
     "before": {"status": "received", "on_hand": 2, "reserved": 1}, "expect": {"result": "NOT_FOUND", "after": {"status": "received", "on_hand": 2, "reserved": 1}, "reservation": "active", "events_added": 0}}
  ],
  "concurrency": {
    "harness": [
      "Run against real PostgreSQL (the project database), not an in-memory fake or SQLite.",
      "Each racer uses its own database connection from a separate pool client, so operations are truly independent transactions at the default READ COMMITTED isolation.",
      "Start racers together with a barrier (e.g. Promise.all after all connections are open, or pg_advisory_lock released by a coordinator).",
      "Repeat each scenario at least 50 times with fresh fixtures; any single violation fails the test.",
      "After every iteration run the invariant checks below."
    ],
    "invariant_checks": [
      "0 <= reserved <= on_hand for every lot.",
      "reserved == sum(quantity) of that lot's active, unexpired reservations (after expiring stale holds).",
      "on_hand == sum(receipts) + sum(correction deltas) - sum(pickups) - sum(removals), replayed from inventory events.",
      "No idempotency key has more than one inventory event.",
      "A reservation has at most one terminal event (completed, cancelled, or expired)."
    ],
    "scenarios": [
      {"id": "Q1", "title": "Two students race for the last unit", "start": {"lot": "lot-last", "status": "received", "on_hand": 1, "reserved": 0},
       "racers": [{"actor": "student-a", "op": "reserve", "quantity": 1, "idempotency_key": "qa"}, {"actor": "student-b", "op": "reserve", "quantity": 1, "idempotency_key": "qb"}],
       "expect": "Exactly one ok and one INSUFFICIENT_STOCK. Final reserved=1, on_hand=1, exactly one active reservation, one reserve event."},
      {"id": "Q1-stress", "title": "Ten students race for the last unit", "start": {"lot": "lot-last", "status": "received", "on_hand": 1, "reserved": 0},
       "racers": "10 distinct verified campus-north students, reserve 1 each, distinct keys",
       "expect": "Exactly one ok; nine INSUFFICIENT_STOCK. Final reserved=1."},
      {"id": "Q2", "title": "One student double-submits the same reservation", "start": {"lot": "lot-two", "status": "received", "on_hand": 2, "reserved": 0},
       "racers": [{"actor": "student-a", "op": "reserve", "quantity": 1, "idempotency_key": "dup"}, {"actor": "student-a", "op": "reserve", "quantity": 1, "idempotency_key": "dup"}],
       "expect": "Both responses name the same reservation id (or the loser gets a retryable in-progress response that resolves to it). Final reserved=1, one reserve event."},
      {"id": "Q3", "title": "Cancel races a new reservation for the same unit", "start": {"lot": "lot-last", "status": "received", "on_hand": 1, "reserved": 1, "holder": "student-a"},
       "racers": [{"actor": "student-a", "op": "cancel"}, {"actor": "student-b", "op": "reserve", "quantity": 1}],
       "expect": "Either cancel commits first and student-b gets the unit (reserved=1, held by student-b) or reserve commits first and fails INSUFFICIENT_STOCK (reserved=0). Never reserved=2 or reserved<0."},
      {"id": "Q4", "title": "Expiry sweep races a reservation for an expired-held unit", "start": {"lot": "lot-last", "status": "received", "on_hand": 1, "reserved": 1, "holder": "student-a, past expires_at"},
       "racers": [{"actor": "system", "op": "expire_sweep"}, {"actor": "student-b", "op": "reserve", "quantity": 1}],
       "expect": "student-b succeeds. student-a's hold is expired exactly once (one release event total). Final reserved=1."},
      {"id": "Q5", "title": "Pickup races cancel on the same reservation", "start": {"lot": "lot-two", "status": "received", "on_hand": 2, "reserved": 1, "holder": "student-a"},
       "racers": [{"actor": "staff-commons", "op": "pickup"}, {"actor": "student-a", "op": "cancel"}],
       "expect": "Exactly one succeeds; the other gets INVALID_STATE. Pickup wins: on_hand=1, reserved=0, completed. Cancel wins: on_hand=2, reserved=0, cancelled."},
      {"id": "Q6", "title": "Pickup races expiry at the deadline", "start": {"lot": "lot-two", "status": "received", "on_hand": 2, "reserved": 1, "holder": "student-a, clock = expires_at"},
       "racers": [{"actor": "staff-commons", "op": "pickup"}, {"actor": "system", "op": "expire_sweep"}],
       "expect": "At server_now >= expires_at pickup must not succeed: RESERVATION_EXPIRED. Final on_hand=2, reserved=0, expired, one release event."},
      {"id": "Q7", "title": "Two staff confirm the same pickup with different keys", "start": {"lot": "lot-two", "status": "received", "on_hand": 2, "reserved": 1, "holder": "student-a"},
       "racers": [{"actor": "staff-commons", "op": "pickup", "idempotency_key": "p1"}, {"actor": "staff-commons", "op": "pickup", "idempotency_key": "p2"}],
       "expect": "One ok, one INVALID_STATE. Final on_hand=1, reserved=0, one pickup event."},
      {"id": "Q8", "title": "Two staff confirm the same receipt with different keys", "start": {"lot": "lot-pledged", "status": "pledged", "on_hand": 0, "reserved": 0},
       "racers": [{"actor": "staff-commons", "op": "receive", "quantity": 2, "idempotency_key": "r1"}, {"actor": "staff-commons", "op": "receive", "quantity": 2, "idempotency_key": "r2"}],
       "expect": "One ok, one INVALID_STATE. Final on_hand=2, one receipt event."},
      {"id": "Q9", "title": "Removal races a reservation", "start": {"lot": "lot-last", "status": "received", "on_hand": 1, "reserved": 0},
       "racers": [{"actor": "staff-commons", "op": "remove", "reason": "Unsafe"}, {"actor": "student-b", "op": "reserve", "quantity": 1}],
       "expect": "Final status=removed, on_hand=0, reserved=0, no active reservations. The reserve either fails NOT_RESERVABLE or succeeds and is then cancelled by the removal transaction."},
      {"id": "Q10", "title": "Downward correction races a reservation", "start": {"lot": "lot-two", "status": "received", "on_hand": 2, "reserved": 1, "holder": "student-a"},
       "racers": [{"actor": "staff-commons", "op": "correct", "on_hand": 1, "reason": "Recount"}, {"actor": "student-b", "op": "reserve", "quantity": 1}],
       "expect": "Never reserved > on_hand. Either correction wins (on_hand=1, reserve fails INSUFFICIENT_STOCK) or reserve wins (reserved=2, correction fails WOULD_VIOLATE_RESERVATIONS)."}
    ],
    "negative_control": "Prove Q1 can fail: behind a test-only flag, run an unsafe reserve that reads available, sleeps (pg_sleep(0.05)), then increments reserved unconditionally. Q1 must report an oversell (reserved=2) for that variant. If it does not, the harness is not racing and its passing result means nothing."
  },
  "open_questions": [
    "HOLD_TTL value and whether staff can extend a hold (MVP.md: 'Agree on reservation expiry').",
    "Whether staff may confirm a receipt quantity above the pledge (these vectors reject it, R6).",
    "Whether a donor may reserve their own offered item.",
    "Per-student reservation limits per lot or per day.",
    "Whether a passed food date_label automatically blocks reservations or only flags the lot for staff removal (these vectors only cover staff removal).",
    "Final error code names and HTTP mapping belong to the app-foundation API contract; rename here once that contract is published."
  ]
}
